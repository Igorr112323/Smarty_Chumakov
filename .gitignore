
# Внешние данные бенчмарка: не коммитятся (лицензия не подтверждена), см. scripts/fetch_rushallu.py
spanverify-module/data/external/

# Служебные файлы тестов и окружения: в релиз не попадают
spanverify-module/.coverage
.coverage
.venv/

# Кэш байт-кода Python: не хранится в репозитории
__pycache__/
*.pyc

# Подписанный договор содержит персональные данные (паспорт, ИНН, адрес, счёт),
# репозиторий публичный. В репозитории хранится только извлечение требований без
# персональных данных — docs/ДОГОВОР_ИЗВЛЕЧЕНИЕ.md и SHA-256 файла. Сам договор
# лежит локально у получателя гранта; проверка читает его через переменную
# SPANVERIFY_CONTRACT_PDF (scripts/contract_check.py → contract.source).
Договор_*.pdf
Договор *.pdf

# Обученный на A3 бандл калибровки вердикта: воспроизводится из train-части
# (scripts/calibrate_verdict.py --save-bundle), в репозиторий не коммитится.
spanverify-module/reports/verdict/bundle_*.json
